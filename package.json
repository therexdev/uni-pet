{
  "name": "uni-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "contracts:build": "node scripts/build-contracts.mjs",
    "contracts:test": "npm --prefix contracts test",
    "check": "npm run contracts:build && npm run contracts:test && npm test && npm run build",
    "test:browser": "node scripts/browser-test.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "koilib": "^9.4.0",
    "kondor-js": "^1.3.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
